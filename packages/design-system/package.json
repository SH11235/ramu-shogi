{
    "name": "@shogi/design-system",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "sideEffects": [
        "./src/theme.css"
    ],
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "default": "./dist/index.js"
        },
        "./theme.css": "./src/theme.css",
        "./tailwind.preset": "./tailwind.preset.ts",
        "./src/theme.css": "./src/theme.css"
    },
    "scripts": {
        "build": "tsc -p tsconfig.build.json",
        "dev": "tsc -p tsconfig.build.json --watch",
        "format": "pnpm --workspace-root exec biome format --write .",
        "format:check": "pnpm --workspace-root exec biome format .",
        "lint": "pnpm --workspace-root exec biome check .",
        "lint:fix": "pnpm --workspace-root exec biome check --write --files-ignore-unknown=true",
        "lint:fix:unsafe": "pnpm --workspace-root exec biome check --write --unsafe --files-ignore-unknown=true",
        "typecheck": "tsc -p tsconfig.json",
        "test": "vitest"
    },
    "dependencies": {
        "clsx": "catalog:",
        "tailwind-merge": "catalog:",
        "tailwindcss-animate": "catalog:"
    },
    "peerDependencies": {
        "react": ">=19 <20",
        "react-dom": ">=19 <20",
        "tailwindcss": "^3.4.0 || ^4.3.3"
    },
    "devDependencies": {
        "@types/react": "catalog:",
        "happy-dom": "catalog:",
        "tailwindcss": "catalog:",
        "typescript": "catalog:",
        "vitest": "catalog:"
    }
}
