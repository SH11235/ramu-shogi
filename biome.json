{
    "$schema": "https://biomejs.dev/schemas/2.6.8/schema.json",
    "vcs": {
        "enabled": true,
        "clientKind": "git",
        "useIgnoreFile": true
    },
    "files": {
        "includes": [
            "**",
            "!**/packages/rust-core",
            "!**/src-tauri",
            "!**/infra/pulumi",
            "!**/packages/match-client/src/rshogi-csa/result-codes.json"
        ],
        "ignoreUnknown": true
    },
    "css": {
        "parser": {
            "cssModules": true,
            "tailwindDirectives": true
        }
    },
    "markdown": {
        "formatter": {
            "enabled": false
        }
    },
    "yaml": {
        "formatter": {
            "enabled": false
        }
    },
    "formatter": {
        "enabled": true,
        "indentStyle": "space",
        "indentWidth": 4,
        "lineWidth": 100
    },
    "linter": {
        "enabled": true,
        "rules": {
            "preset": "recommended",
            "style": {
                "useImportType": {
                    "level": "error",
                    "fix": "unsafe"
                },
                "noRestrictedImports": {
                    "level": "error",
                    "options": {
                        "paths": {
                            "react": {
                                "importNames": ["useMemo", "useCallback", "memo"],
                                "message": "React Compiler が自動メモ化します。手動 memoization は不要です。Compiler がスキップするコンポーネントに限り biome-ignore で残してください。"
                            }
                        }
                    }
                }
            },
            "correctness": {
                "noUnusedImports": {
                    "level": "error",
                    "fix": "unsafe"
                },
                "noUnusedVariables": "off"
            },
            "suspicious": {
                "noExplicitAny": "error"
            },
            "a11y": {
                "noLabelWithoutControl": {
                    "level": "error",
                    "options": {
                        "inputComponents": ["NativeSelect"]
                    }
                }
            }
        }
    },
    "assist": {
        "enabled": true,
        "actions": {
            "source": {
                "organizeImports": "on"
            }
        }
    }
}
