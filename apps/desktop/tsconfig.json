{
    "extends": "../../tsconfig.base.json",
    "compilerOptions": {
        "types": ["react", "react-dom"],
        "noEmit": true,
        "paths": {
            "@shogi/app-core": ["packages/app-core/src/index.ts"],
            "@shogi/app-controller": ["packages/app-controller/src/index.ts"],
            "@shogi/design-system": ["packages/design-system/src"],
            "@shogi/design-system/*": ["packages/design-system/src/*"],
            "@shogi/ui": ["packages/ui/src"],
            "@shogi/ui/*": ["packages/ui/src/*"],
            "@shogi/engine-client": ["packages/engine-client/src"],
            "@shogi/engine-client/*": ["packages/engine-client/src/*"],
            "@shogi/engine-tauri": ["packages/engine-tauri/src"],
            "@shogi/engine-tauri/*": ["packages/engine-tauri/src/*"],
            "@shogi/match-client": ["packages/match-client/src"],
            "@shogi/match-client/*": ["packages/match-client/src/*"]
        }
    },
    "include": ["src"],
    "references": [{ "path": "./tsconfig.node.json" }]
}
