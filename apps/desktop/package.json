{
    "name": "desktop",
    "private": true,
    "version": "0.1.0",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "check:env": "node ../../scripts/check-env.mjs --dir . --mode production",
        "build": "pnpm check:env && pnpm typecheck && vite build",
        "preview": "vite preview",
        "format": "pnpm --workspace-root exec biome format --write .",
        "format:check": "pnpm --workspace-root exec biome format .",
        "lint": "pnpm --workspace-root exec biome check .",
        "lint:fix": "pnpm --workspace-root exec biome check --write --files-ignore-unknown=true",
        "lint:fix:unsafe": "pnpm --workspace-root exec biome check --write --unsafe --files-ignore-unknown=true",
        "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.node.json",
        "test": "vitest run",
        "tauri": "tauri"
    },
    "dependencies": {
        "@shogi/app-controller": "workspace:*",
        "@shogi/app-core": "workspace:*",
        "@shogi/design-system": "workspace:*",
        "@shogi/engine-tauri": "workspace:*",
        "@shogi/study-client": "workspace:*",
        "@shogi/ui": "workspace:*",
        "@tauri-apps/api": "catalog:",
        "@tauri-apps/plugin-dialog": "catalog:",
        "@tauri-apps/plugin-store": "catalog:",
        "react": "catalog:",
        "react-dom": "catalog:"
    },
    "devDependencies": {
        "@babel/core": "catalog:",
        "@rolldown/plugin-babel": "catalog:",
        "@tailwindcss/vite": "catalog:",
        "@tauri-apps/cli": "catalog:",
        "@testing-library/react": "catalog:",
        "@types/node": "catalog:",
        "@types/react": "catalog:",
        "@types/react-dom": "catalog:",
        "@vitejs/plugin-react": "catalog:",
        "babel-plugin-react-compiler": "catalog:",
        "happy-dom": "catalog:",
        "tailwindcss": "catalog:",
        "typescript": "catalog:",
        "vite": "catalog:",
        "vitest": "catalog:"
    }
}
