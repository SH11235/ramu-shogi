{
    "name": "web",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "dev:workers": "node ../../scripts/dev-room-workers.mjs",
        "record:room-game-start": "node ../../scripts/record-room-game-start.mjs",
        "check:env": "node ../../scripts/check-env.mjs --dir . --mode production",
        "build": "pnpm check:env && tsc -b && vite build",
        "build:analyze": "pnpm check:env && ANALYZE=true tsc -b && ANALYZE=true vite build",
        "format": "pnpm --workspace-root exec biome format --write .",
        "format:check": "pnpm --workspace-root exec biome format .",
        "lint": "pnpm --workspace-root exec biome check .",
        "lint:fix": "pnpm --workspace-root exec biome check --write --files-ignore-unknown=true",
        "lint:fix:unsafe": "pnpm --workspace-root exec biome check --write --unsafe --files-ignore-unknown=true",
        "preview": "vite preview",
        "typecheck": "tsc -b --noEmit",
        "test": "vitest run",
        "test:e2e": "playwright test",
        "test:e2e:rooms": "playwright test -c playwright.room.config.ts",
        "test:visual": "playwright test -c playwright.visual.config.ts",
        "test:visual:update": "playwright test -c playwright.visual.config.ts --update-snapshots"
    },
    "dependencies": {
        "@shogi/api-contract": "workspace:*",
        "@shogi/app-controller": "workspace:*",
        "@shogi/app-core": "workspace:*",
        "@shogi/design-system": "workspace:*",
        "@shogi/engine-client": "workspace:*",
        "@shogi/engine-wasm": "workspace:*",
        "@shogi/match-client": "workspace:*",
        "@shogi/study-client": "workspace:*",
        "@shogi/ui": "workspace:*",
        "@tanstack/react-router": "~1.162.9",
        "react": "^19.2.3",
        "react-dom": "^19.2.3"
    },
    "devDependencies": {
        "@cloudflare/workers-types": "^5.20261019.1",
        "@playwright/test": "^1.58.2",
        "@tailwindcss/vite": "^4.3.3",
        "@testing-library/react": "^16.3.2",
        "@types/node": "^24.10.1",
        "@types/react": "^19.2.7",
        "@types/react-dom": "^19.2.3",
        "@vitejs/plugin-react": "^5.2.0",
        "babel-plugin-react-compiler": "^1.0.0",
        "happy-dom": "^21.0.4",
        "rollup-plugin-visualizer": "^6.0.5",
        "tailwindcss": "^4.3.3",
        "typescript": "~5.9.3",
        "vite": "^7.3.7",
        "vitest": "^4.1.12",
        "wrangler": "^4.151.3"
    }
}
