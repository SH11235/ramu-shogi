{
    "$schema": "https://unpkg.com/knip@5/schema.json",
    "includeEntryExports": true,
    "workspaces": {
        "packages/engine-wasm": {
            "entry": [
                "src/index.ts",
                "src/engine.worker.single.ts",
                "src/engine.worker.threaded.ts"
            ]
        }
    },
    "ignoreDependencies": ["wrangler", "babel-plugin-react-compiler", "@tauri-apps/plugin-store"],
    "ignoreIssues": {
        "packages/api-contract/src/generated/**": ["types"],
        "packages/api-contract/src/index.ts": ["types"]
    },
    "ignore": [
        "apps/desktop/src-tauri/target/**",
        "apps/web/worker/index.ts",
        "packages/rust-core/target/**",
        "packages/rust-core/pkg/**",
        "packages/rust-core/crates/shogi-rules-wasm/pkg/**",
        "packages/rust-core/crates/shogi-rules-wasm/scripts/copy-to-backend.mjs",
        "infra/pulumi/**"
    ]
}
