{
    "$schema": "https://unpkg.com/knip@6/schema.json",
    "includeEntryExports": true,
    "workspaces": {
        "packages/engine-wasm": {
            "entry": [
                "src/index.ts",
                "src/engine.worker.single.ts",
                "src/engine.worker.threaded.ts"
            ],
            "ignoreBinaries": ["wasm-bindgen"]
        },
        "packages/match-protocol": {
            "includeEntryExports": false
        }
    },
    "ignoreDependencies": ["wrangler", "@tauri-apps/plugin-store"],
    "ignoreIssues": {
        "packages/api-contract/src/generated/**": ["types"],
        "packages/api-contract/src/index.ts": ["types"]
    },
    "ignore": [
        "packages/rust-core/crates/shogi-rules-wasm/scripts/copy-to-backend.mjs",
        "infra/pulumi/**"
    ],
    "ignoreExportsUsedInFile": {
        "interface": true,
        "type": true
    }
}
