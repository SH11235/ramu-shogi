{
    "$schema": "https://unpkg.com/knip@5/schema.json",
    "workspaces": {
        "packages/engine-wasm": {
            "entry": [
                "src/index.ts",
                "src/engine.worker.single.ts",
                "src/engine.worker.threaded.ts"
            ]
        }
    },
    "ignoreDependencies": [
        "wasm-opt",
        "wrangler",
        "babel-plugin-react-compiler",
        "@tauri-apps/plugin-store"
    ],
    "ignoreIssues": {
        "packages/api-contract/src/generated/**": ["types"]
    },
    "ignore": [
        "apps/desktop/src-tauri/target/**",
        "apps/web/worker/index.ts",
        "apps/web/worker/api.ts",
        "apps/web/worker/room-do.ts",
        "packages/rust-core/target/**",
        "packages/rust-core/pkg/**"
    ]
}
